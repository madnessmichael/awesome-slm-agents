{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SLM agent paper catalog",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^\\d{4}\\.\\d{4,5}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "short_name": {
        "type": "string",
        "minLength": 1
      },
      "authors": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "first_published": {
        "type": "string",
        "format": "date"
      },
      "last_revised": {
        "type": [
          "string",
          "null"
        ],
        "format": "date"
      },
      "source_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "version_reviewed": {
        "type": "string",
        "pattern": "^v[1-9]\\d*$"
      },
      "primary_category": {
        "enum": [
          "perspectives",
          "training",
          "tools",
          "recovery",
          "memory",
          "collaboration",
          "routing",
          "edge",
          "evaluation"
        ]
      },
      "tier": {
        "enum": [
          "core",
          "supporting",
          "background"
        ]
      },
      "model_size_summary": {
        "type": "string",
        "minLength": 1
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "parameters_total_b": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "parameters_active_b": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "name",
            "parameters_total_b",
            "parameters_active_b"
          ],
          "additionalProperties": false
        }
      },
      "parameters_total_b": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "parameters_active_b": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "benchmarks": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "resources": {
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "format": "uri",
            "pattern": "^https://"
          },
          "weights": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "format": "uri",
            "pattern": "^https://"
          },
          "dataset": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "required": [
          "code",
          "weights",
          "dataset"
        ],
        "additionalProperties": false
      },
      "publication": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "preprint",
              "accepted_author_reported",
              "accepted",
              "published"
            ]
          },
          "venue": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "status_source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "required": [
          "status",
          "venue",
          "status_source"
        ],
        "additionalProperties": false
      },
      "contribution": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "string",
        "minLength": 1
      },
      "limitation": {
        "type": "string",
        "minLength": 1
      },
      "verification": {
        "type": "object",
        "properties": {
          "metadata_verified": {
            "type": "boolean"
          },
          "abstract_reviewed": {
            "type": "boolean"
          },
          "full_text_reviewed": {
            "type": "boolean"
          },
          "human_reviewed": {
            "type": "boolean"
          },
          "reproduced": {
            "type": "boolean"
          },
          "manuscript_sections_reviewed": {
            "type": "boolean"
          },
          "checked_on": {
            "type": "string",
            "format": "date"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "review_scope": {
            "type": "string",
            "minLength": 1
          },
          "sections_reviewed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "human_reviewer": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "metadata_verified",
          "abstract_reviewed",
          "full_text_reviewed",
          "human_reviewed",
          "reproduced",
          "manuscript_sections_reviewed",
          "checked_on",
          "method",
          "review_scope",
          "sections_reviewed",
          "human_reviewer"
        ],
        "additionalProperties": false
      },
      "evaluation": {
        "type": "object",
        "properties": {
          "metric": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "attempt_budget": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "hardware": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "cost_per_success": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "teacher_at_inference": {
            "type": [
              "boolean",
              "string",
              "null"
            ]
          }
        },
        "required": [
          "metric",
          "attempt_budget",
          "hardware",
          "cost_per_success",
          "teacher_at_inference"
        ],
        "additionalProperties": false
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "note": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "inclusion_reason": {
        "type": "string",
        "minLength": 1
      },
      "metadata_notes": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "note_version_reviewed": {
        "type": "string",
        "pattern": "^v[1-9]\\d*$"
      },
      "reproduction_manifest": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      }
    },
    "required": [
      "id",
      "title",
      "short_name",
      "authors",
      "first_published",
      "last_revised",
      "source_url",
      "version_reviewed",
      "primary_category",
      "tier",
      "model_size_summary",
      "models",
      "parameters_total_b",
      "parameters_active_b",
      "benchmarks",
      "resources",
      "publication",
      "contribution",
      "evidence",
      "limitation",
      "verification",
      "evaluation",
      "tags",
      "note",
      "inclusion_reason"
    ],
    "additionalProperties": false
  }
}
